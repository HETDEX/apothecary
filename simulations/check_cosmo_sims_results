#!/usr/bin/env python

# check the results of simulations run
# takes 0 or 1 parameter, the shot
# if shot not specified, checks all simXXX dirs in the current folder


import numpy as np
import os
import sys
import glob
from tqdm import tqdm
import traceback
from hetdex_api.config import HDRconfig
from astropy.table import Table

PRINT_EXCEPTIONS = True #print out exception backtrace when they occur
PRINT_INTERMEDIATE = False #print out "bad" directories as they occur rather than just at the end

cl_args = list(map(str.lower,sys.argv))
singledir = False
try:
    if len(cl_args) == 2:
        shot = str((cl_args[1]))
        singledir = True
    else:
        shot = None
except:
    shot = None


if shot is None:
    dirnames = sorted(glob.glob("j???/sim20*s666")) #skip those that have some extra extension, like .timeout
else:
    if "sim" in shot:
        dirnames = [shot] #assume of form: sim20171019v003s666
    elif "v" in shot: #assume of form 20171019v003
        dirnames = [f"sim{shot}s666"]
    else: #assume just 20171019003
        dirnames = [f"sim{shot[0:8]}v{shot[8:]}s666"]


survey_name = "hdr5"
hetdex_api_config = HDRconfig(survey_name)
ampflag_table = Table.read(hetdex_api_config.badamp) #shotid multifraem flag   (0=bad)

bad_dirs = []
bad_dirs_string = []
possible_bad_dirs = []
possible_bad_string =[]
not_yet_run_dirs = []
in_progress_dirs = []
done_dirs = []


def write_status(path,shot,status):
    try:
        with open(os.path.join(path,f"{shot}.status"),"w") as f:
            f.write(status)
            f.write("\n")
    except Exception as e:
        print("Failure to record status file.",e)



for dn in tqdm(dirnames):
    #check HETDEX.o* file (at least last line)
    #sim20170327v011s666
    #shotid = int(f"{dn[3:11]}{dn[12:15]}")
    try:


        #todo: multiple shots (dirnames) per output file now
        # get the jXXX from the dirname?
        # scan for the datevshot ... see if it completed
        job = dn.split("/")[-2]
        datevshot = dn.split("/")[-1][3:-4]


        hetdex_log = sorted(glob.glob(f"HETDEX{job}.o*")) #may be more than one
        if len(hetdex_log) > 0:
            hetdex_log = hetdex_log[-1]
        else:
            #this one has not executed yet
            not_yet_run_dirs.append(dn)
            continue

        with open(os.path.join(hetdex_log),"r") as f:

            #todo: here find the lines that deal with THIS shot
            lines = f.readlines()
            shot_done = False
            idx1 = None
            idx2 = None

            #find the lines (indices) for the start and finish of THIS job
            sel2 = np.array([("Done sim" in line) and (datevshot in line) for line in lines])
            if np.count_nonzero(sel2) > 0:
                try:
                    idx2 = np.where(sel2)[0][0]
                    shot_done = True #BUT even if DONE, could be a problem, like paramiko
                except:
                    idx2 = len(lines)-1 #this one is not done OR it died
            else:
                idx2 = len(lines) - 1  # this one is not done OR it died


            if True: #not shot_done:  #BUT even if DONE, could be a problem, like paramiko

                #need to find where it started
                sel1 = np.array([("Starting" in line) and (datevshot in line) for line in lines])
                if np.count_nonzero(sel1) > 0:
                    try:
                        idx1 = np.where(sel1)[0][0]
                    except:
                        idx1 = None


                if idx1 is not None:
                    #get the indices
                    lines = lines[idx1:idx2+1]
                    flat_lines = "".join(lines)

                    if not ("Cleaning up ..." in lines[-2] and "Removed." in lines[-1]):
                        #something is wrong
                        #print(lines[-2])
                        #print(lines[-1])

                    #FIRST PART
                    #slurmstepd: error: *** JOB 1697795 ON c511-063 CANCELLED AT 2025-03-17T23:25:09 DUE TO TIME LIMIT ***

                        if "CANCELLED" in flat_lines:
                            if "TIME LIMIT" in flat_lines:
                                badstr = f"{dn} Bad {hetdex_log} file. Timed out."
                            else:
                                badstr = f"{dn} Bad {hetdex_log} file. Cancelled."
                        elif "paramiko.ssh_exception" in flat_lines:
                            sel_idx = ["paramiko.ssh_exception" in l for l in lines]
                            badstr = f"{dn} Bad {hetdex_log} file. line: {np.array(lines)[sel_idx][-1].rstrip()}"
                        #elif "***" in lines[-1] or "***" in lines[-2] or "slurmstepd" in lines[-1]:
                        elif "slurmstepd" in flat_lines:
                            sel_idx = ["slurmstepd" in l for l in lines]
                            badstr = f"{dn} Bad {hetdex_log} file. line: {np.array(lines)[sel_idx][-1].rstrip()}"
                        elif "FIRST PART" in lines[-1] or "Running" in lines[-1] or len(lines[-1]) < 3:
                            in_progress_dirs.append(dn)
                            continue #this is okay, just skip and keep going
                        elif shot_done: #this is probably good
                            badstr = None
                            pass
                        else:
                            badstr = f"{dn} Bad? {hetdex_log} file. [Need to check again]. Last line: {lines[-1].rstrip()}"

                        if badstr is not None:
                            bad_dirs_string.append(badstr)
                            bad_dirs.append(dn)

                            write_status(path=dn,shot=datevshot,status=badstr)

                            if PRINT_INTERMEDIATE:
                                print(badstr)

                            continue
                        #else this is probably still good, keep going
                else:
                    # this one is not done and has not started


                    #might have been skipped on a re-run
                    sel1 = np.array([("skipping" in line) and (datevshot in line) for line in lines])
                    idx1 = None
                    if np.count_nonzero(sel1) > 0:
                        try:
                            idx1 = np.where(sel1)[0][0]
                        except:
                            idx1 = None
                    if idx1 is None:
                        not_yet_run_dirs.append(dn)
                        continue
                    else:
                        #this has been skipped ... so count it as done?
                        done_dirs.append(dn)
                        continue

    except:
        if PRINT_EXCEPTIONS:
            print(traceback.format_exc())
        #this is a fail
        badstr = f"{dn} Bad HETDEX{job}.o* file."
        bad_dirs_string.append(badstr)
        bad_dirs.append(dn)
        write_status(path=dn, shot=datevshot, status=badstr)
        if PRINT_INTERMEDIATE:
            print(badstr)
        continue

    #check ./output directory .find files are not zero length
    try:
        findfiles = sorted(glob.glob(os.path.join(dn,"output","*.find")))
        if len(findfiles) < 5: #there should be 1 per IFU ... fewest is actually 9, I think in early 2017
            badstr =f"{dn} Bad output/*.find files. Too few: {len(findfiles)}"
            bad_dirs_string.append(badstr)
            bad_dirs.append(dn)
            write_status(path=dn, shot=datevshot, status=badstr)
            if PRINT_INTERMEDIATE:
                print(badstr)
            continue

        fail = False
        zero_ct = 0
        at_least_one_bad_amp = 0
        for fn in findfiles:
            sz = os.path.getsize(fn)
            if sz == 0:
                #is this a bad amp?
                #20240305v021_313_023_010_032.find
                try:
                    bn = os.path.basename(fn)
                    toks = bn.split("_")
                    shotid = int(toks[0].replace('v',''))
                    multiframe = f"multi_{toks[1]}_{toks[2]}_{toks[3]}"

                    badamp_ct = 0
                    t = ampflag_table[ampflag_table['shotid']==shotid]
                    if len(t) > 0:
                        for amp in ["LU","LL","RU","RL"]:
                            ampsel = np.array(t['multiframe'] == f"{multiframe}_{amp}")
                            badamp_ct += np.count_nonzero(t['flag'][ampsel] == 0)

                    if badamp_ct < 4: # really should never by greater than
                        if singledir:
                            print(f"{bn} has {badamp_ct} amps marked bad.")
                        zero_ct += 1
                        if badamp_ct > 0:
                            at_least_one_bad_amp += 1


                except:
                    if PRINT_EXCEPTIONS:
                        print(traceback.format_exc())
                        exit(-1)
                    zero_ct += 1

        if zero_ct > 0:
            do_continue = True
            if zero_ct == len(findfiles):
                badstr =f"{dn} Bad output/*.find files. ALL zero size."
                bad_dirs_string.append(badstr)
                bad_dirs.append(dn)
                write_status(path=dn, shot=datevshot, status=badstr)
                if PRINT_INTERMEDIATE:
                    print(badstr)
                continue
            elif zero_ct > (0.5 * len(findfiles)): #half or more are zero
                badstr =f"{dn} Bad output/*.find files. Most ({zero_ct} / {len(findfiles)}) are zero size."
                bad_dirs_string.append(badstr)
                bad_dirs.append(dn)
                write_status(path=dn, shot=datevshot, status=badstr)
                if PRINT_INTERMEDIATE:
                    print(badstr)
                continue
            else:
                # !!! BUT do not skip to the next directory,
                # !!! go ahead and continue

                if zero_ct <= np.ceil(0.1 * len(findfiles)): #probably this is okay
                    do_continue = False #do not reset to top of loop, this one is still okay
                    if PRINT_INTERMEDIATE:
                        badstr = f"{dn} Will count as okay, but output/*.find files. {zero_ct} / {len(findfiles)} zero size."
                        print(badstr)
                        write_status(path=dn, shot=datevshot, status=badstr)
                elif zero_ct % 3 == 0: #a multiple of 3, bad/masked IFU/amps
                    if at_least_one_bad_amp > 0 and at_least_one_bad_amp %3 == 0:
                        badstr = f"{dn} Possible bad output/*.find files. {zero_ct} / {len(findfiles)} zero size. Some masked IFUs/Amps."
                        possible_bad_dirs.append(dn)
                        possible_bad_string.append(badstr)
                        write_status(path=dn, shot=datevshot, status=badstr)
                        if PRINT_INTERMEDIATE:
                            print(badstr)
                    else:

                        badstr =f"{dn} Possible bad output/*.find files. {zero_ct} / {len(findfiles)} zero size."
                        possible_bad_dirs.append(dn)
                        possible_bad_string.append(badstr)
                        write_status(path=dn, shot=datevshot, status=badstr)
                        if PRINT_INTERMEDIATE:
                            print(badstr)
                else:
                    badstr =f"{dn} Possible bad output/*.find files. {zero_ct} / {len(findfiles)} zero size."
                    possible_bad_dirs.append(dn)
                    possible_bad_string.append(badstr)
                    write_status(path=dn, shot=datevshot, status=badstr)
                    if PRINT_INTERMEDIATE:
                        print(badstr)

            if do_continue:
                continue

        #we made it to the end, assume good
        done_dirs.append(dn)
        #note: checks below may overwrite this status
        write_status(path=dn, shot=datevshot, status=f"{dn} good")

    except:
        if PRINT_EXCEPTIONS:
            print(traceback.format_exc())
        badstr = f"{dn} Bad output/*.find files."
        bad_dirs_string.append(badstr)
        bad_dirs.append(dn)
        write_status(path=dn, shot=datevshot, status=badstr)
        if PRINT_INTERMEDIATE:
            print(badstr)
        continue

    #check .sim file exists and is populated
    try:
        simfile = sorted(glob.glob(os.path.join(dn,"*.sim")))
        if len(simfile) == 0:
            badstr =f"{dn} Missing *.sim file."
            bad_dirs_string.append(badstr)
            bad_dirs.append(dn)
            write_status(path=dn, shot=datevshot, status=badstr)
            if PRINT_INTERMEDIATE:
                print(badstr)

            continue
        elif len(simfile) != 1:
            badstr = f"{dn} Too many *.sim files. {len(simfile)}"
            bad_dirs_string.append(badstr)
            bad_dirs.append(dn)
            write_status(path=dn, shot=datevshot, status=badstr)
            if PRINT_INTERMEDIATE:
                print(badstr)
            continue
        else:
            simfile = simfile[0]
            sz = os.path.getsize(simfile)
            if sz == 0:
                badstr = f"{dn} Zero length *.sim file."
                bad_dirs_string.append(badstr)
                bad_dirs.append(dn)
                write_status(path=dn, shot=datevshot, status=badstr)
                if PRINT_INTERMEDIATE:
                    print(badstr)
                continue
    except:
        if PRINT_EXCEPTIONS:
            print(traceback.format_exc())
        badstr = f"{dn} Bad *.sim file."
        bad_dirs_string.append(badstr)
        bad_dirs.append(dn)
        write_status(path=dn, shot=datevshot, status=badstr)
        if PRINT_INTERMEDIATE:
            print(badstr)
        continue

print("\nSummary:")
if len(bad_dirs_string) > 0:
    for dn in bad_dirs_string:
        print(dn)

if len(possible_bad_string) > 0:
    for dn in possible_bad_string:
        print(dn)

print("-------------------------------")
print(f"Checked {len(dirnames)} sim directories")
print(f"{len(bad_dirs)} bad")
print(f"{len(possible_bad_dirs)} possibly bad")
print(f"{len(not_yet_run_dirs)} waiting to run (or not found)")
print(f"{len(in_progress_dirs)} still running")
print(f"{len(done_dirs)} done")


#temporary
# print("\n ... not yet run??? ...")
# for x in not_yet_run_dirs:
#     print(x)


os.makedirs("done_good", exist_ok=True)
os.makedirs("done_bad", exist_ok=True)
os.makedirs("done_bad_possible", exist_ok=True)

with open("copy_good.txt","w") as f:
    for dn in done_dirs:
        bn = os.path.basename(dn) #e.g. simYYYYMMDDvSSSs666
        sim = bn[3:] + ".sim" #e.g YYYYMMDDvSSSs666.sim
        f.write(f"cp {dn}/{sim} done_good \n")

with open("copy_bad.txt","w") as f:
    for dn in bad_dirs:
        bn = os.path.basename(dn) #e.g. simYYYYMMDDvSSSs666
        sim = bn[3:] + ".sim" #e.g YYYYMMDDvSSSs666.sim
        if os.path.exists(f"{dn}/{sim}"):
            f.write(f"cp {dn}/{sim} done_bad \n")
        else:
            f.write(f"touch done_bad/{sim} \n")

with open("copy_bad_possible.txt","w") as f:
    bn = os.path.basename(dn)  # e.g. simYYYYMMDDvSSSs666
    sim = bn[3:] + ".sim"  # e.g YYYYMMDDvSSSs666.sim
    for dn in possible_bad_dirs:
        f.write(f"cp {dn}/{sim} done_bad_possible \n")

