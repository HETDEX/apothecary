resdir=$(pwd)
#datadir="/scratch/00115/gebhardt"
mkdir -p $resdir/spec/
datadir="/scratch/03261/polonius/"
cut=20.
date=$1
shot=$2
cd /tmp
#cd tmp
mkdir -p maxflux$1v$2
cd maxflux$1v$2
cp ${resdir}/rfindmax .
cp ${resdir}/rspcs .
cp ${resdir}/rf1 .


cp ${resdir}/../detect/20*v???/norm.dat norm.dat
cp ${resdir}/../detect/20*v???/fwhm.out fwhm.use
ln -s ${resdir}/../detect/20*v???.dithall local.dithall

#this is the default set, it can be repalced via sed from the calling
# script (e.g. from reduce_shot.py)
exp_array=("exp01" "exp02" "exp03")

for exp in "${exp_array[@]}";do
  echo "rgetmax $exp"
  ln -s ${datadir}/red1/reductions/$date/virus/virus0000$2/${exp}/virus/m*fits .
  ls m*fits | awk '{print "rfindmax",$1,exp0}' exp0=${exp} | sed s/.fits// > run1
  chmod +x run1
  run1

  rm m*fits
  grep . m*dat | sed s/.dat:/_/ | awk '{print $0,exp0}' exp0=${exp} > d1
  rm m*dat

  awk '{if($2>cut0||$3>cut0) print $0}' cut0=$cut d1 > d2
  awk '{print "grep",$1,"local.dithall | grep",$4}' date0=$date shot0=$shot d2 > rj1
  chmod +x rj1
  rj1 > d3
  awk '{print $8}' d3 | sed s/.ixy// | awk '{print "grep",$1,"d2"}' > rj2
  chmod +x rj2
  rj2 > d5

  paste d5 d3 | awk '{print $5,$6,$2,$3,$1}' > d4

done



